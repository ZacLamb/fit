<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">TRAINING</span>
      <h1 style="max-width:none;">Coaching for every stage of training.</h1>
      <p>From your first movement consult to sport-specific performance work, every program is coached one-on-one.</p>
    </div>
    <div class="grid grid-3">
      <% services.forEach(function(s) { %>
        <div class="panel">
          <div class="panel-tag"><%= s.duration_min %> MIN SESSION</div>
          <h3><%= s.name %></h3>
          <p><%= s.short_desc %></p>
          <div class="panel-price"><%= s.price_label %></div>
          <a href="/services/<%= s.slug %>" class="panel-link">View Details &rsaquo;</a>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="facility-strip">
  <img src="/images/stock/sprint-start.jpg" alt="Athlete training at Zezze Athletics" onerror="this.src='/images/facility.jpg'">
</section>

<section class="section section-turf text-center">
  <div class="container">
    <h2>Not sure which program fits?</h2>
    <p class="text-center" style="color:var(--chalk); opacity:0.95;">Start with a free movement consult and we'll point you to the right one.</p>
    <a href="/booking" class="btn btn-outline on-dark">Book a Free Consult</a>
  </div>
</section>

<%- include('partials/footer') %>
