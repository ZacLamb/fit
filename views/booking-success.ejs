<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="alert-success">
      <h2 style="max-width:none;">You're booked, <%= booking.client_name.split(' ')[0] %>.</h2>
      <p><strong><%= booking.service %></strong><br>
      <%= new Date(booking.date + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) %> at <%= booking.start_time %><br>
      2 Tupper Rd, Sandwich, MA</p>
      <p>A confirmation has been noted for booking #<%= booking.id %>. See you on the floor.</p>
    </div>
    <a href="/" class="btn btn-outline">Back to Home</a>
  </div>
</section>

<%- include('partials/footer') %>
